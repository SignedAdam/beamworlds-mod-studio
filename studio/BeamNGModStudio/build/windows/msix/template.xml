<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="beamngmodstudio.exe"
        Arguments=""
        InstallLocation="C:\Program Files\BeamWorlds\BeamWorlds Mod Studio">
    </Installer>
    <PackageInformation
        PackageName="BeamWorlds Mod Studio"
        PackageDisplayName="BeamWorlds Mod Studio"
        PublisherName="CN=BeamWorlds"
        PublisherDisplayName="BeamWorlds"
        Version="0.2.0.0"
        PackageDescription="Local-first BeamNG mod library and ModMaker">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.beamworlds.modstudio"
                Description="Local-first BeamNG mod library and ModMaker"
                DisplayName="BeamWorlds Mod Studio"
                ExecutableName="beamngmodstudio.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>BeamWorlds Mod Studio</DisplayName>
            <PublisherDisplayName>BeamWorlds</PublisherDisplayName>
            <Description>Local-first BeamNG mod library and ModMaker</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="beamngmodstudio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
